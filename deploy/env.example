# Copy to ~/.config/agent-chat/env on the server. Read by the systemd units and
# by deploy/backup.sh and deploy/update.sh, so keep it to KEY=value lines
# with absolute paths (neither reader expands ~).

# Flags for agent-chat. A LAN-facing server over plain http:
AGENT_CHAT_ARGS="--allow-remote --host 0.0.0.0"
# Behind a reverse proxy on the same host, keep the loopback default instead:
# AGENT_CHAT_ARGS=""

# Set these if the flags above move the port or the data directory.
# AGENT_CHAT_URL=http://127.0.0.1:8000
# AGENT_CHAT_DATA_DIR=/srv/agent-chat/state

# Where backup.sh writes snapshots, and how many it keeps.
# AGENT_CHAT_BACKUP_DIR=/srv/agent-chat/backups
# AGENT_CHAT_BACKUP_KEEP=30
